PORT=5509
# Listen address. 127.0.0.1 when a tunnel/reverse proxy on the same box fronts it.
# HOST=127.0.0.1
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "true" only if serving over HTTPS (Cloudflare tunnel terminates TLS, but
# the tunnel forwards as HTTPS so this should be true in production).
COOKIE_SECURE=false
# Trust the first proxy (Cloudflare tunnel). Leave true behind cloudflared.
TRUST_PROXY=true
